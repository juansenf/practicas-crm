# --- Base de datos -----------------------------------------------------------
# PostgreSQL. Local con `npx prisma dev`, o el connection string del proveedor
# (Neon, Supabase, Railway, etc.). Requerido.
DATABASE_URL="postgresql://usuario:password@localhost:5432/practicas_crm?schema=public"

# Base dedicada a las pruebas de integración. Si no se define, esos tests se
# omiten y solo corren los unitarios. Se prepara con `npm run db:test:prepare`.
# IMPORTANTE: debe ser una base (o instancia) distinta de DATABASE_URL, porque
# la suite borra sus tablas. Con `prisma dev`, levantá una segunda instancia:
#   npx prisma dev -d -n test
# TEST_DATABASE_URL="postgresql://usuario:password@localhost:5432/practicas_crm_test?schema=public"

# --- Autenticación -----------------------------------------------------------
# Secreto usado para firmar los JWT (HS256). Requerido, mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres"

# --- Opcionales --------------------------------------------------------------
# Tiempo de vida de la sesión en segundos (por defecto 8 horas).
# SESSION_TTL_SECONDS=28800
